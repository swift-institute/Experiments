sil_stage canonical

import Builtin
import Swift
import SwiftShims

public struct HeapStorage : StorageProtocol, ~Copyable {
  public typealias Element = Int
  @_hasStorage public let capacity: Int { get }
  @usableFromInline
  @_hasStorage let base: UnsafeMutablePointer<Int> { get }
  public init(capacity: Int)
  public func pointer(at slot: Int) -> UnsafeMutablePointer<Int>
  deinit
}

import Property_Primitives

public struct LinearBuffer : ~Copyable {
  @usableFromInline
  @_hasStorage var storage: HeapStorage { get set }
  public init(capacity: Int)
  public borrowing func checksum(count: Int) -> Int
}

extension LinearBuffer {
  public typealias Property<Tag> = Property<Tag, LinearBuffer>
  public enum BumpTag {
  }
  public var bump: Property<LinearBuffer.BumpTag, LinearBuffer>.Inout {
    mutating _read
    _modify
  }
}

extension Property.Inout where Tag == LinearBuffer.BumpTag, Base == LinearBuffer {
  public mutating func all(by delta: Int, count: Int)
}

public enum Operations {
  public static func fill<S>(_ storage: borrowing S, count: Int, value: Int) where S : StorageProtocol, S.Element == Int, S : ~Copyable
  public static func sum<S>(_ storage: borrowing S, count: Int) -> Int where S : StorageProtocol, S.Element == Int, S : ~Copyable
  public static func bump<S>(_ storage: borrowing S, count: Int, by delta: Int) where S : StorageProtocol, S.Element == Int, S : ~Copyable
}

public protocol StorageProtocol : ~Copyable {
  associatedtype Element : ~Copyable
  var capacity: Int { get }
  func pointer(at slot: Int) -> UnsafeMutablePointer<Self.Element>
}

import Property_Primitives

public protocol LinearBufferProtocol : ~Copyable {
  associatedtype Store : StorageProtocol, ~Copyable where Self.Store.Element == Int
  var store: Self.Store { get }
  var elementCount: Int { get }
}

public enum SharedBumpTag {
}

extension LinearBufferProtocol where Self : ~Copyable {
  public typealias SharedProperty = Property<SharedBumpTag, Self>
  public var bumpShared: Property<SharedBumpTag, Self>.Inout {
    mutating _read
    _modify
  }
}

extension Property.Inout where Tag == SharedBumpTag, Base : LinearBufferProtocol, Base : ~Copyable {
  public mutating func all(by delta: Int, count: Int)
}

extension LinearBuffer : LinearBufferProtocol {
  public var store: HeapStorage { _read }
  public var elementCount: Int { get }
  typealias Store = HeapStorage
}

